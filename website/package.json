{
  "name": "set-me-up-website",
  "version": "0.1.0",
  "private": true,
  "description": "Set-me-up marketing site using the asciicn application stack",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4175",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 4175",
    "typecheck": "tsc --noEmit",
    "test": "bun test scripts",
    "check:shared-ui": "python3 scripts/sync-docs-ui.py --check",
    "ci": "bun run check && bun run build",
    "check:upstream": "bun scripts/check-upstream.ts",
    "lint": "oxlint app components lib hooks constants seo scripts --deny-warnings",
    "check:markdown": "markdownlint-cli2",
    "check:mermaid": "bun scripts/check-quality.ts mermaid",
    "check:loc": "bun scripts/check-quality.ts loc",
    "check": "bun run lint && bun run check:markdown && bun run check:mermaid && bun run check:loc && bun run check:shared-ui && bun run check:upstream && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@tailwindcss/postcss": "^4.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fumadocs-core": "^16.8.4",
    "fumadocs-mdx": "^14.3.1",
    "jiti": "^2.6.1",
    "jotai": "^2.19.1",
    "lru-cache": "^11.3.5",
    "motion": "^12.38.0",
    "next": "16.2.4",
    "next-themes": "0.4.6",
    "postcss": "^8.5.10",
    "radix-ui": "^1.4.3",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-hotkeys-hook": "^5.2.4",
    "rehype-pretty-code": "^0.14.3",
    "shiki": "^4.0.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "vaul": "^1.1.2",
    "zod": "^4.3.6",
    "mermaid": "^11.12.0",
    "lenis": "^1.3.11"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/jsdom": "21.1.7",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "jsdom": "26.0.0",
    "markdownlint-cli2": "0.20.0",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.3.13",
  "type": "module"
}
